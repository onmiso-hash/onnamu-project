#!/usr/bin/env bash
# push 직전에 도는 검사. 실패하면 push가 중단된다.
# 설치: git config core.hooksPath .githooks   (클론마다 한 번)
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if [ -x "$ROOT/scripts/check_cloud_core_pin.sh" ]; then
  "$ROOT/scripts/check_cloud_core_pin.sh" || exit 1
fi

if [ -x "$ROOT/scripts/check_core_pin.sh" ]; then
  "$ROOT/scripts/check_core_pin.sh" || exit 1
fi

if [ -x "$ROOT/scripts/check_deploy_cmd_len.sh" ]; then
  "$ROOT/scripts/check_deploy_cmd_len.sh" || exit 1
fi

# 갤러리 신분 검사 — 다른 사람 출입증으로 들어가지는가(2026-08-18 사고).
# 파이썬을 못 찾으면 조용히 넘어가지 않고 막는다. 이 검사는 건너뛰면 안 되는 종류다.
if [ -f "$ROOT/scripts/check_gallery_identity.py" ]; then
  PY=""
  for cand in "$ROOT/.venv/bin/python" python3 python; do
    if "$cand" -c "import flask" >/dev/null 2>&1; then PY="$cand"; break; fi
  done
  if [ -z "$PY" ]; then
    echo "[갤러리 신분 검사] 막음 — flask를 가진 파이썬을 못 찾아 검사를 돌리지 못했습니다."
    echo "  .venv를 만들거나 flask를 설치한 뒤 다시 push 하세요."
    exit 1
  fi
  "$PY" "$ROOT/scripts/check_gallery_identity.py" || exit 1
fi

# 신분·권한 공통 규칙 검사 — 같은 규칙이 두 벌이 되지 않는가, 지금 권한을 실제로 묻는가.
# 위와 같은 이유로 파이썬을 못 찾으면 조용히 넘어가지 않고 막는다.
if [ -f "$ROOT/scripts/check_identity_common.py" ]; then
  PY=""
  for cand in "$ROOT/.venv/bin/python" python3 python; do
    if "$cand" -c "import flask" >/dev/null 2>&1; then PY="$cand"; break; fi
  done
  if [ -z "$PY" ]; then
    echo "[공통 신분 검사] 막음 — flask를 가진 파이썬을 못 찾아 검사를 돌리지 못했습니다."
    exit 1
  fi
  "$PY" "$ROOT/scripts/check_identity_common.py" || exit 1
fi

exit 0
